---
import Logo from './Logo.astro';
import { LANG_PATHS, LINKEDIN_URL } from '../lib/site.js';
interface Props { lang: 'en' | 'es' | 'pt'; t: any; }
const { lang, t } = Astro.props;
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap footer-inner">
    {/* Columna Izquierda: Logo, descripción de alcance y derechos */}
    <div class="footer-col-left">
      <Logo id="foot" class="brand" style="width:110px" />
      <p>{t.footer.disclaimer}</p>
      <div class="footer-location">
        <span>{t.footer.location}</span>
      </div>
    </div>

    {/* Columna Derecha: Región/expansión, políticas y red profesional */}
    <div class="footer-col-right">
      <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="footer-social-link" title="LinkedIn de Symbio">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.88 0-1.6-.72-1.6-1.6 0-.89.72-1.61 1.6-1.61.88 0 1.6.72 1.6 1.61 0 .88-.72 1.6-1.6 1.6M7.86 18.5V10.13H5.07V18.5h2.79z" />
        </svg>
        <span>LinkedIn</span>
      </a>

      <div class="footer-nav-links">
        <a href="/privacy.html" class="footer-link">{t.footer.privacy}</a>
      </div>

      <div class="footer-nav-links footer-langs">
        <a href={LANG_PATHS.en} hreflang="en" lang="en" class="footer-link" data-lang="en">English</a>
        <a href={LANG_PATHS.es} hreflang="es" lang="es" class="footer-link" data-lang="es">Español</a>
        <a href={LANG_PATHS.pt} hreflang="pt" lang="pt" class="footer-link" data-lang="pt">Português</a>
      </div>

      <span class="footer-copy">© {year} {t.footer.rights}</span>
    </div>
  </div>
</footer>

