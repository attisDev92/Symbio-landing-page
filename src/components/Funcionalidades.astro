---
interface Props { t: any; }
const { t } = Astro.props;
const items = t.features.items;
const icons = [
  'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
  'M12 8v4l3 3M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z',
  'M3 3v18h18M8 17V9m5 8V5m5 12v-6',
  'M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11z',
  'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15z',
];
---
<section class="wrap" id="funcionalidades">
  <!-- Gradiente compartido por todos los íconos -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="iconGrad" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="var(--accent1)" /><stop offset="1" stop-color="var(--accent2)" />
      </linearGradient>
    </defs>
  </svg>
  <div class="section-head reveal">
    <h2>{t.features.title}</h2>
    <p>{t.features.subtitle}</p>
  </div>
  <div class="features">
    {items.map((item: any, i: number) => (
      i === 0 ? (
        <div class="feat big reveal">
          <div>
            <svg class="feat-icon" viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="url(#iconGrad)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[i]} /></svg>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ) : (
        <div class="feat reveal">
          <svg class="feat-icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="url(#iconGrad)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[i]} /></svg>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      )
    ))}
  </div>
</section>

